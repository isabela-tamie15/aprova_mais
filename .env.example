# Copie este arquivo para .env e preencha os valores. O .env não vai para o GitHub
# Perfil obrigatório: dev na máquina local, prod no servidor
SPRING_PROFILES_ACTIVE=dev
# JWT_SECRET e ENCRYPTION_SECRET: no mínimo 32 bytes aleatórios, gerados com: openssl rand -base64 48
DB_URL=
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
ENCRYPTION_SECRET=
RESEND_API_KEY=
APP_URL=
# Redis fora do Docker (aplicação rodando pela IDE): localhost e 6379. No docker-compose, o host e a porta já vêm definidos
REDIS_HOST=localhost
REDIS_PORT=6379
# Senha do Redis do docker-compose (obrigatória). Use só letras e números, porque ela entra no REDIS_URL
REDIS_PASSWORD=
ADMIN_INICIAL_EMAIL=
ADMIN_INICIAL_SENHA=
ADMIN_INICIAL_NOME=
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
ARMAZENAMENTO_DIRETORIO=
# Senha do admin do Grafana (docker-compose), em http://localhost:3000
GRAFANA_SENHA=
# Remetente dos e-mails
EMAIL_REMETENTE=
